{
    "name": "eventflex-server",
    "version": "1.0.0",
    "description": "EventFlex backend — Node.js/Express API",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "dev:clean": "powershell -Command \"Stop-Process -Id (Get-NetTCPConnection -LocalPort 5000 -ErrorAction SilentlyContinue).OwningProcess -Force -ErrorAction SilentlyContinue\" & nodemon server.js",
        "kill-port": "powershell -Command \"Stop-Process -Id (Get-NetTCPConnection -LocalPort 5000 -ErrorAction SilentlyContinue).OwningProcess -Force -ErrorAction SilentlyContinue\"",
        "test": "jest --runInBand",
        "test:unit": "jest tests/unit --runInBand",
        "test:property": "jest tests/property --runInBand"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "csv-writer": "^1.6.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-validator": "^7.1.0",
        "firebase-admin": "^10.3.0",
        "jsonwebtoken": "^9.0.2",
        "mongodb-memory-server": "^10.0.0",
        "mongoose": "^8.4.1",
        "nodemailer": "^8.0.5",
        "pdf-lib": "^1.17.1",
        "pdfkit": "^0.15.0",
        "qrcode": "^1.5.4",
        "razorpay": "^2.9.2",
        "socket.io": "^4.7.5",
        "stripe": "^15.12.0",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "fast-check": "^3.19.0",
        "jest": "^29.7.0",
        "mongodb-memory-server": "^10.0.0",
        "nodemon": "^3.1.4",
        "supertest": "^7.0.0"
    }
}
